@load 'lang/database'
@load 'lang/table'
@load 'lang/html'
@load 'lang/server'

Task_Type [TODO BUG DESIGN]

# This struct represents the table columns for a single Task
Task <
	id: Primary_Key
	type: Task_Type
	done := false
	text: String
>

All_Tasks_Page + Div {
	tasks_table: Table

	html_id := 'tasks'
	input   := Textarea()
	button  := Button("Add Task")

	Self (tasks_table;
		self.tasks_table = tasks_table

		button.onclick = (;
			new_task := Task(text := input.value)
			tasks_table.create(new_task)
		)
	)


	render (;
		list := tasks_table.all().map((it;
			# An unset `type` reads back as `nil` (a task created before a type was ever assigned) --
			# guard against that before displaying it.
			type_display := if it.type == nil
				''
			else
				" -- `it.type`"
			end
			status := if it.done == true
				' (done)'
			else
				''
			end
			Li([A("/`it.id`", it.text), type_display, status])
		))

		Form([
			input,
			button,
			list
		])
	)
}

Single_Task_Page + Div {
	tasks_table: Table
	task: Task

	html_id := 'task' # without this, X-Code-Target-Id never gets set and the client falls back to
		   # replacing the whole <html> document, which the browser refuses

	type_radios := []
	text_input: Textarea
	done_checkbox := Checkbox()
	save_button := Button("Save")

	Self (tasks_table, task_id: Number;
		self.tasks_table = tasks_table
		self.task   = tasks_table.find(task_id)

		# One Radio for each Task_Type. They share the name 'type', so the browser lets only one be checked.
		# Task_Type.@keys are the names ('BUG'), and Task_Type.@values the members (:BUG), in the same order.
		for Task_Type.@keys
			radio      := Radio(html_name := 'type', html_value := it, html_checked := it == task.type)
			type_value := Task_Type.@values.get(at)

			# dom.js sends the checked state of every radio in the group, so each one's value is true or false
			radio.onclick = (;
				if radio.value == true
					tasks_table.update(task.id, <type := type_value>)
				end
				for type_radios
					it.html_checked = it.value == true
				end
			)
			type_radios.push(radio)
		end

		# Passing task.text as the constructor arg renders it as the textarea's own inner text,
		# pre-filling it visibly (`.value` is a separate, browser-only thing the client JS reads at
		# submit time -- unrelated to what actually renders).
		self.text_input = Textarea(task.text)

		# `done := false` gives every task a real default, and the DB layer coerces a Bool column back
		# to a proper true/false on read -- so this is just cheap insurance, not a required guard.
		task.done = task.done == true

		done_checkbox.html_checked = task.done
		done_checkbox.onclick = (;
			task.done = done_checkbox.value == true
			tasks_table.update(task.id, <done := task.done>)
			done_checkbox.html_checked = task.done
		)

		save_button.onclick = (;
			task.text = text_input.value
			tasks_table.update(task.id, <text := task.text>)

			# text_input was built once, in Self(;), from the task as it was on page load -- updating the
			# database alone doesn't change what it already rendered. Without rebuilding it here too, the
			# response sent back after Save would still show the old text until the next full reload.
			self.text_input = Textarea(task.text)
		)
	)

	render (;
		[
			H1(task.text),
			Br(),
			type_radios.map(( it; Label([it, it.html_value]) )),
			Br(),
			text_input,
			Br(),
			Label([done_checkbox, 'Done']),
			save_button,
			A('/', 'Back to all')
		]
	)
}

Inverted_Html + Html {
	css_filter := 'invert()'
}

App + Server {
	DB := @connect Sqlite.memory()
	tasks := DB.find_or_create_table(Task)

	# root path /
	get:// (;
		Inverted_Html(All_Tasks_Page(tasks))
	)

	get://:id (id;
		Inverted_Html(Single_Task_Page(tasks, id.to_i()))
	)

	get://terminal (;
		Terminal_Canvas_Page() # the Html is in the component
	)
}


app := App()
@start_server app

My_Canvas + Canvas {
	html_id     := 'crt-screen'
	html_width  := '640'
	html_height := '480'
}

Cascadia_Font_Link + Link {
    html_rel  := 'stylesheet'
    html_href := 'https://cdn.jsdelivr.net/npm/@fontruby/cascadia-mono@5.0.1/index.css'
}

Terminal_Canvas_Page + Html {
    canvas := My_Canvas()
    draw_script := Script()

    html_id := 'canvas-container'
	css_background_color := '#051308'
    css_color := '#fff'

    Self (;
       draw_script.children = ["
          const canvas = document.getElementById('crt-screen');
          const ctx = canvas.getContext('2d');

          let inputBuffer = 'SYSTEM READY> ';
          let mouseX = 0, mouseY = 0;
          let cursorVisible = true;

          setInterval(() => { cursorVisible = !cursorVisible; draw(); }, 500);

          function draw() {
             ctx.fillStyle = '#051308';
             ctx.fillRect(0, 0, 640, 480);

             // Specified Cascadia Mono here
             ctx.fillStyle = '#33ff66';
             ctx.font = '20px \"Cascadia Mono\" monospace';

             const textToRender = inputBuffer + (cursorVisible ? '_' : ' ');
             ctx.fillText(textToRender, 30, 60);

             // Mouse Block Tracer
             ctx.fillStyle = 'rgba(51, 255, 102, 0.4)';
             ctx.fillRect(mouseX - 10, mouseY - 10, 20, 20);

             // Scanlines
             ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
             for (let y = 0; y < 480; y += 4) {
                ctx.fillRect(0, y, 640, 2);
             }
          }

          canvas.addEventListener('mousemove', (e) => {
             const rect = canvas.getBoundingClientRect();
             mouseX = e.clientX - rect.left;
             mouseY = e.clientY - rect.top;
             draw();
          });

          window.addEventListener('keydown', (e) => {
             if (e.key === 'Backspace') {
                inputBuffer = inputBuffer.slice(0, -1);
             } else if (e.key.length === 1) {
                inputBuffer += e.key;
             }
             draw();
          });

          // Wait for custom font payload to settle before rendering to canvas
          document.fonts.ready.then(() => {
             draw();
          });
       "]
    )

    render (;
        [Utf8_Meta(), Cascadia_Font_Link(), canvas, draw_script]
    )
}
