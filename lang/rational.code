# `Rational(1, 3)` is an exact fraction. It wraps a Ruby Rational (see ruby/proxies/rational.rb), so
# `Rational(1, 3) + Rational(1, 6)` is exactly `1/2`, which a Float cannot promise. `Rational(0.34)` is
# `17/50`, and `Rational('1/108')` reads a string. Mixed math follows Ruby: Integer and Rational give a
# Rational, Float and Rational give a Float.
Rational | Number {
	Self ( value := 0, denominator := 1;
		self.value = value
		self.value = self.value / denominator
	)
}
