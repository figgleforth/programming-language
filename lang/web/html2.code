###
Struct-and-render take on lang/web/html.code, same spirit as lang/web/css.code: markup is plain, immutable data (one struct shape for every element), and a single Renderer walks it -- no per-tag Type, no `| Dom` composition, no method-override polymorphism. The two coexist.

It only builds an HTML String. An Element with `onclick` (or another `on<event>`), `on_server_read` or `replacement_target_id` is live when a server route renders it: the formatter writes the runtime's data-runtime-* attributes, through `@on_event` and `@on_server_read`.

The server does not know about Element. Any renderer that writes the same attributes gets the same live behavior.
###
@load 'lang/visitor'
@load 'lang/web/css'

### 1. The one node shape ###

# One HTML attribute -- mirrors css.code's `Property <name, value>` exactly, same reason: a plain name/value struct instead of a Dictionary entry, so attributes list/reorder/duplicate the same way css declarations do (see Html_Lint_Visitor's duplicate-attribute check below, impossible on a Dictionary but a real risk now that attributes are an ordered Array).
Attribute <name: String, value: Any>


###
- `children` holds a mix of Element structs and plain Strings (text nodes) -- Html_Formatter_Visitor tells them apart by `=== Element`, same as css.code's visitors tell rule kinds apart by `=== Style_Rule`.
- `attributes` is an ordered Array\Attribute, not a Dictionary -- same reasoning as `css` below: build it with the same struct-literal style css.code declarations already use (`Attribute("class", "card")`).
- `css` is a real css.code rule tree (`Css`'s own union -- Style_Css/At_Css/Scope_Css/...), not a flat Dictionary of properties -- see Html_Formatter_Visitor#render_element, which renders it as an embedded <style> child wherever it's attached, so `@scope`-based rules work the way you'd expect.
###
Element <
	tag: String
	attributes: Array\Attribute = []
	css: Css
	children: Array = []
	onclick: Any_Func
	on_server_read: Any_Func
	replacement_target_id: String
	# The other browser events. Each closure runs on the server and gets the element's own value: the text for input, change, focus and blur, the key for keydown and keyup, and nothing for submit
	oninput: Any_Func
	onchange: Any_Func
	onsubmit: Any_Func
	onkeydown: Any_Func
	onkeyup: Any_Func
	onfocus: Any_Func
	onblur: Any_Func
>

### 2. Formatter (render + minify + pretty-print, same "one type, a mode flag" shape as lang/web/css.code's Css_Formatter_Visitor) ###

Html_Formatter_Visitor {
	DEFAULT_INDENT := 2
	indent_size: Int = DEFAULT_INDENT
	minify: Bool = false

	# Never given a closing tag, regardless of mode -- matches how lang/web/html.code's own generic Dom#to_s already never self-closes anything either (no new inconsistency introduced there), it just means these never emit an *empty* `</tag>` at all, in either mode.
	VOID_TAGS := %string(area base br col command embed hr img input keygen link meta param source track wbr)

	# The text inside these is JavaScript or CSS, not HTML, so it is never escaped.
	RAW_TEXT_TAGS := %string(script style)

	# The browser keeps each space and new line inside these as text, so the pretty form writes their content compact.
	WHITESPACE_TAGS := %string(pre textarea)

	Self ( indent_size: Int = DEFAULT_INDENT, minify: Bool = false;
		self.indent_size = indent_size
		self.minify = minify
	)

	render ( node, depth: Int = 0, raw: Bool = false -> String;
		if node === Element
			render_element(node, depth)
		else
			text := node.?to_s() or "`node`"
			if raw
				text
			else
				escape("`text`")
			end
		end
	)

	# Prefixes every line of a block of text with `depth`'s padding -- used to line an embedded stylesheet's formatted CSS up inside a pretty-printed page.
	indent_block ( text, depth: Int -> String;
		pad := indent_str(depth)
		(text.?split("\n") or [text]).map(line; "`pad``line`").join("\n")
	)

	render_element ( el: Element, depth: Int -> String;
		pad := indent_str(depth)
		attrs := render_attributes(el)
		raw_text := self.RAW_TEXT_TAGS.include?(el.tag)
		###
		- `css`, if attached, renders as one more child (an embedded <style> block) rather than folding into `attrs` -- a real Css tree (selectors, nesting, @scope, ...) has no equivalent as a flat attribute the way a simple property:value Dictionary would have.
		- note; `.concat` mutates its receiver (Ruby's own destructive Array#concat, under the hood) -- `el.children` is the struct's own array, so `.concat` would silently and permanently corrupt it (double-appending the css child on a second render). `.flatten()` builds a fresh array instead.
		###
		full_children := if el.css == nil
			el.children
		elif el.tag == "style"
			# css set directly on a <style> -- format it in place, no second <style> wrapper
			[Css_Formatter_Visitor(indent_size := self.indent_size, minify := self.minify).format(el.css)]
		else
			[el.children, [css_child(el.css)]].flatten()
		end

		if self.VOID_TAGS.include?(el.tag)
			if self.minify "<`el.tag``attrs`>" else "`pad`<`el.tag``attrs`>" end
		elif self.minify
			inner := full_children.map(c; render(c, raw := raw_text)).join("")
			"<`el.tag``attrs`>`inner`</`el.tag`>"
		elif full_children.length() == 0
			# No children: one line, so an empty element gets no new line inside.
			"`pad`<`el.tag``attrs`></`el.tag`>"
		elif self.WHITESPACE_TAGS.include?(el.tag)
			compact := Html_Formatter_Visitor(indent_size := self.indent_size, minify := true)
			inner   := full_children.map(c; compact.render(c)).join("")
			"`pad`<`el.tag``attrs`>`inner`</`el.tag`>"
		elif el.tag == "style" and full_children.length() == 1 and !(full_children.0 === Element)
			# An embedded stylesheet -- block layout, its formatted CSS indented one level past the tag. The lone child is either already-formatted CSS text or a raw css.code node to format now.
			css_text := if full_children.0 === String
				full_children.0
			else
				Css_Formatter_Visitor(indent_size := self.indent_size, minify := self.minify).format(full_children.0)
			end
			"`pad`<style`attrs`>\n`indent_block(css_text, depth + 1)`\n`pad`</style>"
		elif full_children.length() == 1 and !(full_children.0 === Element)
			# A single bare-text child stays on one line ("<p>Hello</p>"), rather than always expanding to block style -- keeps the common "leaf text element" case readable.
			"`pad`<`el.tag``attrs`>`render(full_children.0, raw := raw_text)`</`el.tag`>"
		else
			inner := full_children.map(c; render(c, depth + 1, raw := raw_text)).join("\n")
			"`pad`<`el.tag``attrs`>\n`inner`\n`pad`</`el.tag`>"
		end
	)

	# Escapes text for HTML, so a text child can never become markup, and an attribute value can never close its quotes. `&` goes first, or it would escape the other entities a second time.
	escape ( text: String -> String;
		text.gsub('&', '&amp;').gsub('<', '&lt;').gsub('>', '&gt;').gsub('"', '&quot;').gsub("'", '&#39;')
	)

	render_attributes ( el: Element -> String;
		parts := []

		for el.attributes
			# A boolean attribute (checked, disabled, selected) is on whenever its name is there, whatever its value. So true gives the bare name, and false or nil leave the attribute out.
			if it.value == true
				parts.push(it.name)
			elif it.value != false and it.value != nil
				value := escape("`it.value`")
				parts.push("`it.name`=\"`value`\"")
			end
		end

		# The runtime's own attributes. Their prefix is DOM_ATTRIBUTE_PREFIX (constants.rb), which `.code` cannot read yet, so its value is written here. @on_event and @on_server_read store the closure and give its token, which needs no escape.
		# Outside a live page (a test, or Code.interp), they give nil, and the attribute is left out. The event names are LIVE_PAGE_EVENTS (constants.rb).
		handlers := [
			['click', el.onclick]
			['input', el.oninput]
			['change', el.onchange]
			['submit', el.onsubmit]
			['keydown', el.onkeydown]
			['keyup', el.onkeyup]
			['focus', el.onfocus]
			['blur', el.onblur]
		]
		for handlers
			(event, handler) := it
			if handler
				token := @on_event(handler)
				parts.push("data-runtime-on`event`=\"`token`\"") if token
			end
		end

		if el.on_server_read
			read_token := @on_server_read(el.on_server_read)
			if read_token
				parts.push("data-runtime-on-server-read=\"`read_token`\"")
			end
		end

		if el.replacement_target_id
			parts.push("data-runtime-replacement-target-id=\"`escape(el.replacement_target_id)`\"")
		end

		if parts.length() == 0
			""
		else
			" `parts.join(' ')`"
		end
	)

	# Shares this visitor's own indent/minify settings so a css tree nested inside a pretty-printed page comes out pretty-printed too (and minified inside a minified one).
	css_child ( rule: Css -> Element;
		Element("style", [], nil, [Css_Formatter_Visitor(indent_size := self.indent_size, minify := self.minify).format(rule)])
	)

	indent_str ( depth: Int -> String;
		if self.minify "" else " " * (depth * self.indent_size) end
	)
}

# Two shared instances: compact (the default, kept for anything that already calls Html_Renderer.render(...)) and pretty/indented.
Html_Renderer := Html_Formatter_Visitor(minify := true)
Html_Formatter := Html_Formatter_Visitor()

### 2b. Stats (node counts, depth, unique tags, estimated raw vs minified size) ###

Html_Stats_Visitor {
	node_count: Int = 0
	max_depth: Int = 0
	tag_counts: Dictionary = {}

	# Resets and walks -- call this first, then read the members below or call minified_size/pretty_size (which just re-render, no walk state needed).
	analyze ( node -> Self;
		self.node_count = 0
		self.max_depth = 0
		self.tag_counts = {}
		visit(node, 0)
		self
	)

	visit ( node, depth: Int;
		if node === Element
			self.node_count += 1

			if depth > self.max_depth
				self.max_depth = depth
			end

			seen := self.tag_counts.fetch(node.tag, 0)
			self.tag_counts[node.tag] = seen + 1

			for node.children
				visit(it, depth + 1)
			end
		end
	)

	unique_tags (-> Array;
		self.tag_counts.keys()
	)

	minified_size ( node -> Int;
		Html_Renderer.render(node).length
	)

	pretty_size ( node -> Int;
		Html_Formatter.render(node).length
	)
}

### 2c. Sanitizer (strips script/iframe/object/embed tags, and on*/javascript: attributes) ###

Html_Sanitizer_Visitor {
	DANGEROUS_TAGS := %string(script iframe object embed)

	# Returns a cleaned tree -- source is untouched (structs are plain data), a dangerous node (and everything under it) is dropped entirely rather than emptied out.
	sanitize ( node;
		if node === Element
			if self.DANGEROUS_TAGS.include?(node.tag)
				nil
			else
				clean_children := []
				for node.children
					cleaned := sanitize(it)
					if cleaned != nil
						clean_children.push(cleaned)
					end
				end
				# The closures and the replacement target id stay: they run on the server, so they are not the browser code this removes.
				Element(node.tag, sanitize_attributes(node.attributes), node.css, clean_children, node.onclick, node.on_server_read, node.replacement_target_id, node.oninput, node.onchange, node.onsubmit, node.onkeydown, node.onkeyup, node.onfocus, node.onblur)
			end
		else
			node
		end
	)

	sanitize_attributes ( attributes: Array\Attribute -> Array\Attribute;
		attributes.filter(a; !dangerous_attribute?(a))
	)

	dangerous_attribute? ( attr: Attribute -> Bool;
		if attr.name.start_with?("on")
			true
		else
			trimmed := if (attr.name == "href" or attr.name == "src") and attr.value === String
				attr.value.?trim()
			end
			trimmed != nil and trimmed.start_with?("javascript:")
		end
	)
}

### 2d. Lint
- void element given children
- <img> missing alt
- empty containers
- duplicate attribute names -- attributes are now an ordered Array\Attribute, not a Dictionary, so a duplicate name is a real possibility here now (same as Css_Lint_Visitor's duplicate-property check on an Array\Property)
###

Html_Lint_Visitor + Warnings_Visitor {
	VOID_TAGS := %string(area base br col command embed hr img input keygen link meta param source track wbr)

	lint ( node -> Array;
		self.warnings = []
		visit(node)
		self.warnings
	)

	visit ( node;
		if node === Element
			if self.VOID_TAGS.include?(node.tag) and node.children.length() > 0
				warn("<`node.tag`> is a void element but was given children")
			end

			if node.tag == "img" and !node.attributes.any?(a; a.name == "alt")
				warn("<img> is missing an alt attribute")
			end

			if !self.VOID_TAGS.include?(node.tag) and node.children.length() == 0
				warn("<`node.tag`> is empty")
			end

			check_duplicate_attributes(node)

			for node.children
				visit(it)
			end
		end
	)

	check_duplicate_attributes ( node: Element;
		seen_names := []
		for node.attributes
			if seen_names.include?(it.name)
				warn("<`node.tag`> has a duplicate '`it.name`' attribute")
			end
			seen_names.push(it.name)
		end
	)
}

### 3. Element constructors (recovers the ergonomics lang/web/html.code gets from per-tag Types)
- note; lowercase, not capitalized like lang/web/html.code's Div/Title/etc -- these are functions, and a capitalized name before `(` routes to type-reference parsing instead of a function declaration (found the hard way writing this file).
- Each tag's constructor is made by constructor_for or void_constructor_for, because they all take the same arguments. href and utf8_meta are written out, because each adds an attribute of its own.
###

# A single child (a bare String, or one Element) doesn't need its own `[...]` at every call site -- wrapped here so `li("one")` and `li(["one", "two"])` both just work, same as `li(["one"])` always did.
as_children ( children -> Array;
	if children === Array
		children
	else
		[children]
	end
)

# Same override-in-place-or-append semantics as Dictionary#merge (used to build `href`/`utf8_meta`'s own forced attribute before attributes became an Array) -- only needed where a constructor forces one attribute of its own alongside whatever the caller already passed in.
merge_attribute ( attributes: Array\Attribute, attr: Attribute -> Array\Attribute;
	replaced := false
	merged := for attributes map
		if it.name == attr.name
			replaced = true
			attr
		else
			it
		end
	end
	if replaced
		merged
	else
		merged + [attr]
	end
)

# Makes the constructor for one tag. Every constructor takes the same arguments and only forwards them to Element, so the function is written once here, not once for each tag.
constructor_for ( tag: String -> Any_Func;
	(children := [], attributes: Array\Attribute = [], css: Css = nil, onclick: Any_Func = nil, on_server_read: Any_Func = nil, replacement_target_id: String = nil, oninput: Any_Func = nil, onchange: Any_Func = nil, onsubmit: Any_Func = nil, onkeydown: Any_Func = nil, onkeyup: Any_Func = nil, onfocus: Any_Func = nil, onblur: Any_Func = nil -> Element;
		Element(
			tag,
			attributes,
			css,
			as_children(children),
			onclick,
			on_server_read,
			replacement_target_id,
			oninput,
			onchange,
			onsubmit,
			onkeydown,
			onkeyup,
			onfocus,
			onblur,
		)
	)
)

# The same for a void tag, which has no children, so its first argument is the attributes.
void_constructor_for ( tag: String -> Any_Func;
	(attributes: Array\Attribute = [], css: Css = nil, onclick: Any_Func = nil, on_server_read: Any_Func = nil, replacement_target_id: String = nil, oninput: Any_Func = nil, onchange: Any_Func = nil, onsubmit: Any_Func = nil, onkeydown: Any_Func = nil, onkeyup: Any_Func = nil, onfocus: Any_Func = nil, onblur: Any_Func = nil -> Element;
		Element(
			tag,
			attributes,
			css,
			[],
			onclick,
			on_server_read,
			replacement_target_id,
			oninput,
			onchange,
			onsubmit,
			onkeydown,
			onkeyup,
			onfocus,
			onblur,
		)
	)
)

html  := constructor_for('html')
head  := constructor_for('head')
body  := constructor_for('body')
title := constructor_for('title')
h1    := constructor_for('h1')
h2    := constructor_for('h2')
h3    := constructor_for('h3')
h4    := constructor_for('h4')
h5    := constructor_for('h5')
h6    := constructor_for('h6')

# Text and inline elements
p      := constructor_for('p')
small  := constructor_for('small')
span   := constructor_for('span')

# A link: its first argument is the href.
href ( href: String, children := [], attributes: Array\Attribute = [], css: Css = nil, onclick: Any_Func = nil, replacement_target_id: String = nil -> Element;
	Element(
		"a",
		merge_attribute(attributes, Attribute("href", href)),
		css,
		as_children(children),
		onclick,
		nil,
		replacement_target_id
	)
)

strong := constructor_for('strong')
em     := constructor_for('em')
code   := constructor_for('code')
pre    := constructor_for('pre')

# Lists
ul := constructor_for('ul')
ol := constructor_for('ol')
li := constructor_for('li')

# Forms
form     := constructor_for('form')
input    := void_constructor_for('input')
button   := constructor_for('button')
textarea := constructor_for('textarea')
label    := constructor_for('label')
select   := constructor_for('select')
option   := constructor_for('option')

# Containers
section := constructor_for('section')
article := constructor_for('article')
nav     := constructor_for('nav')
header  := constructor_for('header')
footer  := constructor_for('footer')
main    := constructor_for('main')
aside   := constructor_for('aside')
div     := constructor_for('div')

# Media
img := void_constructor_for('img')

# Tables
table := constructor_for('table')
thead := constructor_for('thead')
tbody := constructor_for('tbody')
tr    := constructor_for('tr')
th    := constructor_for('th')
td    := constructor_for('td')

# Other
br       := void_constructor_for('br')
hr       := void_constructor_for('hr')
dialog   := constructor_for('dialog')
style    := constructor_for('style')
fieldset := constructor_for('fieldset')
legend   := constructor_for('legend')
kbd      := constructor_for('kbd')
samp     := constructor_for('samp')
meta     := void_constructor_for('meta')

utf8_meta ( attributes: Array\Attribute = [], css: Css = nil -> Element;
	Element(
		"meta",
		merge_attribute(attributes, Attribute("charset", "utf-8")),
		css,
		[]
	)
)

link     := void_constructor_for('link')
script   := constructor_for('script')
canvas   := constructor_for('canvas')
