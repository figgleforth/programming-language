@load 'lang/web/http'

# One client's connection, and the bytes that came on it but are not parsed yet
Connection <
	socket: Tcp_Socket
	buffer: Buffer
	continue_sent: Bool
	streaming: Bool   # an event stream: it stays open, and the server only writes to it
	last_active: Float  # Time.monotonic() when bytes last came, or when it opened
>

# The web server. One thread waits on every socket at once (wait_for_ready), so a slow client never holds up the others.
Http_Server {
	SHORT_STOP_WAIT_WHILE_RUNNING := 0.2

	listener: Tcp_Server
	connections: Array

	# A browser opens connections ahead of time and can leave them unused, so neither of these may grow without end. An event stream is idle by design, so only the limit counts it
	idle_seconds    := 30    # a connection that sends nothing for longer than this is closed
	max_connections := 512   # above this, the connection that has waited longest is closed

	# Opens the port. A port that is in use raises here, before the loop starts
	listen ( port: Int;
		self.listener    = Tcp_Server(port)
		self.connections = []
	)

	# The routes' reply to one request: [status, headers, body, streaming, cookies] (Interpreter#respond_to_http_request). cookies: each Set-Cookie value
	respond ( request: Request -> Array; @ruby )

	# True after Interpreter#stop_server asks the loop to end
	stopping? (-> Bool; @ruby )

	run (;
		until stopping?()
			# A short wait, so the loop sees a stop soon
			for listener.wait_for_ready(connections.map(it; it.socket), SHORT_STOP_WAIT_WHILE_RUNNING)
				ready := it
				if ready.@object_id == listener.@object_id
					connections << Connection(listener.wait_for_connection(), Buffer(), false, false, Time.monotonic())
					if connections.count() > max_connections
						waited_longest := connections.sort_by(it; it.last_active).0
						drop(waited_longest)
					end
				else
					connection := connections.find(it; it.socket.@object_id == ready.@object_id)
					bytes      := ready.read_available()
					connection.last_active = Time.monotonic()
					# A stream's client sends nothing more, so its bytes only say whether it closed
					if not bytes or (not connection.streaming and serve(connection, bytes))
						drop(connection)
					end
				end
			end

			now := Time.monotonic()
			for connections.select(it; not it.streaming and now - it.last_active > idle_seconds)
				drop(it)
			end
		end

		for connections
			it.socket.close()
		end

		listener.close()
	)

	# Closes the connection and forgets it
	drop ( connection: Connection;
		connection.socket.close()
		connections = connections.select(it; it.socket.@object_id != connection.socket.@object_id)
	)

	# Adds the bytes, and replies to each whole request in them, in order. Gives true when the connection is done
	serve ( connection: Connection, bytes: Buffer -> Bool;
		connection.buffer.append(bytes)
		# A client can send the next request before it reads the reply to the one before (RFC 9112 §9.3.2), so the buffer can hold more than one
		while request := parse_request(connection.buffer)
			(status, headers, body, streaming, cookies) := respond(request)
			if streaming
				connection.socket.write(stream_head_text(status, headers) + body)
				connection.streaming = true
				return false
			end

			keep_open := keeps_alive?(request)
			connection.socket.write(response_text(status, body, headers, head := request.method == HEAD, keep_alive := keep_open, set_cookies := cookies))
			return true unless keep_open

			# The bytes after this request belong to the next one
			connection.buffer        = connection.buffer.slice(request.message_length)
			connection.continue_sent = false
		end

		if request =>= nil\Incomplete_Message
			# The client sends the body only after this line (RFC 9110 §10.1.1)
			if request.@tag.?expects_continue and not connection.continue_sent
				connection.socket.write("HTTP/1.1 100 Continue\r\n\r\n")
				connection.continue_sent = true
			end
			return false
		end

		status := status_for(request)
		connection.socket.write(response_text(status)) if status
		true
	)
}
