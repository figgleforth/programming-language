# A fixed-size strip of raw bytes, backed by a Ruby IO::Buffer (ruby/proxies/buffer.rb). Read and write typed values at a byte offset. A value too big for its type wraps, like real memory (`:U8` 300 stores 44).
#
# Types: :u8 :s8 :u16 :U16 :s16 :S16 :u32 :U32 :s32 :S32 :u64 :U64 :s64 :S64 :f32 :F32 :f64 :F64
# Lowercase is little-endian, uppercase is big-endian. One byte has no byte order, so :u8 and :U8 are the same (also :s8 and :S8).

@load 'lang/errors'

Out_Of_Bounds | Error <>

Buffer {
	Self ( size: Int = 0;
		self.resize(size)
	)

	# returns size_of in bytes of :u8, etc. There's no documentation for these symbol types :u8, :u16, etc. Eventually you'll be able to write `Buffer.size_of(Int32)` or `Buffer.size_of(var)` or `Buffer.size_of(123)`
	Self.size_of ( type: Symbol | String -> Int; @ruby )

	Self.from_string (string: String -> Buffer; @ruby )

	# Round `n` up to the next multiple of `align` (a power of 2).
	Self.align_up ( n: Int, align: Int -> Int;
		unless align > 0 and (align & (align - 1)) == 0
			@raise "align must be a power of 2, got `align` (`align.@type`)"
		end
		(n + align - 1) & ~(align - 1)
	)

	length (-> Int; @ruby )

	# keeps the old bytes, new bytes are 0
	resize ( size: Int -> Buffer;
		unless size === Integer and size >= 0
			@raise "size must be an Integer, 0 or more, got `size` (`size.@type`)"
		end

		@ruby
	)

	# The end of an Out_Of_Bounds message, in bytes or bits. It reads length() each time, so it stays right after resize() and from_string().
	_size_text ( in_bits := false;
		if length() == 0
			"the buffer is empty"
		elif in_bits
			"the buffer has `length() * 8` bits (bits 0 to `length() * 8 - 1`)"
		else
			"the buffer has `length()` bytes (byte offsets 0 to `length() - 1`)"
		end
	)

	get ( type: Symbol | String, byte_offset: Int -> Number;
		unless byte_offset === Integer
			@raise "byte_offset must be an Integer, got `byte_offset` (`byte_offset.@type`)"
		end

		if byte_offset < 0
			@raise Out_Of_Bounds("reading at byte offset `byte_offset` is before the start: byte offsets start at 0")
		elif byte_offset + Buffer.size_of(type) > length()
			@raise Out_Of_Bounds("reading a `Buffer.size_of(type)`-byte :`type` at byte offset `byte_offset` goes past the end: `_size_text()`")
		end

		@ruby
	)
	get_byte := get

	# type: one of Code::Buffer::TYPES (:u8 :s8 .. :f64 :F64)
	set ( type: Symbol | String, byte_offset: Int, value: Number -> Buffer;
		unless byte_offset === Integer # @pasted
			@raise "byte_offset must be an Integer, got `byte_offset` (`byte_offset.@type`)"
		end
		unless value =>= Number
			@raise "value must be a Number, got `value` (`value.@type`)"
		end

		if byte_offset < 0
			@raise Out_Of_Bounds("writing at byte offset `byte_offset` is before the start: byte offsets start at 0")
		elif byte_offset + Buffer.size_of(type) > length()
			@raise Out_Of_Bounds("writing a `Buffer.size_of(type)`-byte :`type` at byte offset `byte_offset` goes past the end: `_size_text()`")
		end

		@ruby
	)
	set_byte := set

	# sets every byte to `value`
	fill ( value: Int = 0 -> Buffer; @ruby )

	get_string (-> String; @ruby )
	# Read `length` bytes from `start_index` as a String. A `length` of -1 reads to the end. The `length` param hides the length() method here, so this calls self.length().
	get_string_slice ( start_index: Int, length: Int = -1 -> String;
		unless start_index === Integer and length === Integer
			@raise "start_index and length must be Integers, got `start_index` (`start_index.@type`) and `length` (`length.@type`)"
		end

		if start_index < 0
			@raise Out_Of_Bounds("reading at byte offset `start_index` is before the start: byte offsets start at 0")
		elif length < -1
			@raise "length must be 0 or more, or -1 to read to the end, got `length` (`length.@type`)"
		elif start_index > self.length()
			@raise Out_Of_Bounds("reading at byte offset `start_index` goes past the end: `_size_text()`")
		elif length != -1 and start_index + length > self.length()
			@raise Out_Of_Bounds("reading `length` bytes at byte offset `start_index` goes past the end: `_size_text()`")
		end

		@ruby
	)

	# a fresh Array of every byte, 0 to 255
	bytes (-> Array; @ruby )
	hexdump (-> String; @ruby )

	to_s (;
		"Buffer(`length()` bytes)"
	)

	to_string (;
		get_string()
	)

	# Read `width` bits that start at bit number `bit`, and return them as a number.
	# Example: get_bits(6, 4) with byte 0 = 0b11000000 and byte 1 = 0b00000010 reads bits 6, 7, 8, 9 = 1, 1, 0, 1, which gives 0b1011 = 11.
	get_bits ( bit, width -> Int;
		unless bit === Integer and width === Integer
			@raise "bit and width must be Integers, got bit `bit` (`bit.@type`) and width `width` (`width.@type`)"
		end

		if width < 1
			@raise "width must be at least 1, got `width` (`width.@type`)"
		elif bit < 0
			@raise Out_Of_Bounds("reading at bit `bit` is before the start: bits start at 0")
		elif bit + width > length() * 8
			@raise Out_Of_Bounds("reading bits `bit` to `bit + width - 1` goes past the end: `_size_text(in_bits := true)`")
		end

		value := 0
		for 0..<width
			n := bit + it
			one := (self.get(:u8, n >> 3) >> (n & 7)) & 1   # Read the byte that holds bit n, move bit n down to position 0, and keep only it.
			value = value | (one << it)                      # Put that bit at position `it` of the result.
		end
		value
	)

	# Write the low `width` bits of `value`, starting at bit number `bit`. Every other bit stays the same.
	# It reads and writes a whole byte for each bit. That is slow, but simple and correct.
	set_bits ( bit, width, value;
		unless bit === Integer and width === Integer # @pasted
			@raise "bit and width must be Integers, got bit `bit` (`bit.@type`) and width `width` (`width.@type`)"
		end
		unless value === Integer
			@raise "value must be an Integer, got `value` (`value.@type`)"
		end

		if width < 1
			@raise "width must be at least 1, got `width` (`width.@type`)"
		elif bit < 0
			@raise Out_Of_Bounds("writing at bit `bit` is before the start: bits start at 0")
		elif bit + width > length() * 8
			@raise Out_Of_Bounds("writing bits `bit` to `bit + width - 1` goes past the end: `_size_text(in_bits := true)`")
		end

		for 0..<width
			n    := bit + it
			byte := self.get(:u8, n >> 3)   # The byte that holds bit n.
			mask := 1 << (n & 7)            # Only bit n's position inside that byte is set.
			if ((value >> it) & 1) == 1     # Is bit `it` of the new value set?
				byte = byte | mask            # Yes: turn bit n on.
			else
				byte = byte & ~mask           # No: turn bit n off. ~mask is all ones except bit n, so the other bits stay.
			end
			self.set(:u8, n >> 3, byte)
		end
		self
	)

	# A signed value in `width` bits (two's complement): the top bit counts as negative 2^(width - 1), not positive.
	# If the top bit is clear, ^ sign turns it on and - sign takes it off again, so the value does not change.
	# If the top bit is set, ^ sign takes it off and - sign takes the same amount off again, so the top bit now counts as -sign.
	# Example, width 4: raw 1011 = 11, sign = 1000 = 8, 11 ^ 8 = 3, 3 - 8 = -5. And raw 0011 = 3: 3 ^ 8 = 11, 11 - 8 = 3.
	get_bits_signed ( bit, width;
		sign := 1 << (width - 1)   # Only the top bit is set.
		(get_bits(bit, width) ^ sign) - sign
	)
}
