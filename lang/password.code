# Password hashes for a login, with scrypt (ruby/proxies/password.rb). Store the whole hash: it holds its own salt and settings. Two hashes of the same text differ, because each has a new salt.
Password {
	Self.hash ( text: String -> String; @ruby )
	Self.matches? ( text: String, hash: String -> Bool; @ruby )
}

hash_password ( text: String -> String;
	Password.hash(text)
)

password_matches? ( text: String, hash: String -> Bool;
	Password.matches?(text, hash)
)
