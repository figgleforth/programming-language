Array {
	values, # is the internal backing array

	Self ( values := []; @ruby )
	Self.of ( value_to_fill: Any, size: Int -> Array; @ruby )
	Self.new ( size: Int, value_to_fill: Any -> Array; @ruby )

	max (; @ruby )
	min (; @ruby )
	product ( other: Array := nil; @ruby ) # no argument: multiplies every value. An array: the cartesian product

	# add to back/end
	push ( item; @ruby )
	append := push
	add_one_item_to_end := push
	add_one_item_to_back := push
	enqueue := push

	# add to front
	prepend ( item; @ruby )
	unshift := prepend
	add_one_item_to_front := prepend

	# remove from back/end
	pop (; @ruby )
	remove_one_item_from_end := pop
	remove_one_item_from_back := pop

	# remove_from_front
	shift (; @ruby )
	dequeue := shift
	drop_first := shift
	remove_one_item_from_front := shift

	# removal
	delete_if ( fn: (Any -> Bool;); @ruby )
	delete_at ( index: Int; @ruby )
	delete ( object_to_delete: Any; @ruby )

	# get one random item
	random (; @ruby )
	length (; @ruby )
	count := length
	first ( count := 1; @ruby )
	last ( count := 1; @ruby )
	slice ( from, to; @ruby )
	reverse (; @ruby )
	join ( separator; @ruby )
	concat ( other; @ruby )
	flatten (; @ruby )
	sort (; @ruby )
	uniq (-> Array; @ruby )
	empty? (; @ruby )
	get ( index; @ruby )
	index ( item; @ruby ) # index of the first matching element, or nil if not found
	insert ( index, things; @ruby )

	compact (-> Array; @ruby )

	zip (other: Array; @ruby )

	find ( func;
		for values
			if func(it)
				return it
			end
		end
		nil
	)

	include? ( item;
		for values
			if it == item
				return true
			end
		end
		false
	)
	includes? := include?

	exclude? ( item;
		not include?(item)
	)
	excludes? := exclude?

	any? ( func;
		for values
			if func(it)
				return true
			end
		end
		false
	)

	all? ( func;
		for values
			if !func(it)
				return false
			end
		end
		true
	)

	map ( func;
		result := []
		for values
			result.push(func(it, at))
		end
		result
	)

	select ( func;
		result := []
		for values
			if func(it)
				result.push(it)
			end
		end
		result
	)
	filter := select

	reject ( func;
		result := []
		for values
			if not func(it)
				result.push(it)
			end
		end
		result
	)

	accumulate ( initial_value, func;
		accumulator := initial_value
		for values
			accumulator = func(accumulator, it)
		end
		accumulator
	)

	each ( func;
		for values
			func(it)
		end
	)

	to_s (;
		pieces := values.map((it;
			if it === String
				it.?to_string() or "`it`"
			else
				"`it`"
			end
		))
		"[`pieces.join(', ')`]"
	)

	@operator << @infix 600 ( left, right;
		left.append(right)
		left
	)

	@operator >> @infix 600 ( left, right;
		left.delete(right)
		left
	)

	# note; `-`, `&` and `|` are written here, not @ruby, so they compare elements with the language's own `==` (two equal structs match). Each returns a new Array, like Ruby's.
	@operator - @infix 700 ( left, right;
		left.reject(it; right.include?(it))
	)

	@operator & @infix 590 ( left, right;
		result := []
		for left.values
			result.push(it) if right.include?(it) and result.exclude?(it)
		end
		result
	)

	@operator | @infix 570 ( left, right;
		result := []
		for left.values
			result.push(it) if result.exclude?(it)
		end
		for right.values
			result.push(it) if result.exclude?(it)
		end
		result
	)

	# note; Implemented in Backend, same reason as include? above the the Ruby-level Array#== (array.rb)compares elements with Ruby's own native == via the underlying Ruby array, and never sees an Backend-level `@operator ==` overload on a custom Instance (e.g. two structurally-equal Members compared unequal). Declaring this here takes precedence over that Ruby fallback(an operand's own declarations are always checked before it -- see #find_operator_overload).
	@operator == @infix ( left, right;
		if !right.?length or !left.length or left.length() != right.length()
			return false
		end

		for left.values
			unless it == right.get(at)
				return false
			end
		end

		true
	)
}

# What a variadic param binds (`rest...` / `rest: Arguments`)
Arguments | Array {}
Args := Arguments
