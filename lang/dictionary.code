Dictionary {
	hash,

	Self ( hash := {};
		self.hash = hash
	)

	keys (; @ruby )
	values (; @ruby )
	has_key? ( key; @ruby )
	delete ( key; @ruby )
	merge ( other; @ruby )
	count (; @ruby )
	empty? (; @ruby )
	clear (; @ruby )
	fetch ( key, default; @ruby )
	_bare_name? ( key; @ruby )

	each ( func;
		for hash
			func(it.0, it.1)
		end
	)

	select ( func;
		keep := {}
		for hash
			keep[it.0] = it.1 if func(it.0, it.1)
		end
		keep
	)

	reject ( func;
		keep := {}
		for hash
			keep[it.0] = it.1 if not func(it.0, it.1)
		end
		keep
	)

	# Shown the way it is written: `{name = 'Jack', :id = 4, 'first name' = 'J'}`
	to_s (;
		ks     := keys()
		vs     := values()
		pieces := ks.map(( key, at;
			v := vs.get(at)
			displayed := if v === String
				v.?to_string() or "`v`"
			elif v === Symbol
				":`v`"
			else
				"`v`"
			end
			key_text := if key === Symbol
				":`key`"
			elif _bare_name?(key)
				"`key`"
			elif key === String
				"'`key`'"
			else
				"`key`"
			end
			"`key_text` = `displayed`"
		))
		"{`pieces.join(', ')`}"
	)
}

Hash :: Dictionary
Dict :: Dictionary
Map  :: Dictionary
