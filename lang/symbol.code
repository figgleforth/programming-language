Symbol {
	value,
	Self ( value := '';
		self.value = value
	)

	to_s (; @ruby ) # the bare name: :onclick gives 'onclick'
	to_string (-> String;
		':' + to_s()
	)

	length (; @ruby )
	empty? (; @ruby )
	upcase (; @ruby )
	downcase (; @ruby )
	capitalize (; @ruby )
	swapcase (; @ruby )
	start_with? ( prefix; @ruby )
	end_with? ( suffix; @ruby )
}
