@load 'lang/http.code'

# The whole request, through a real socket
server := Tcp_Server(0)

send_request ( text: String -> Request | Nil;
	client     := Tcp_Socket('localhost', server.port)
	connection := server.wait_for_connection()
	client.write(text)
	client.close()

	request := read_request(connection)
	connection.close()
	request
)

request := send_request("POST /hello HTTP/1.1\r\nHost: x\r\nAccept: */*;q=0.8, application/json;q=0\r\nContent-Length: 3\r\n\r\nx=1")
@out request.method                        # out: POST
@out request.target.path                   # out: /hello
@out request.body                          # out: x=1
@out request.accepts.0.value               # out: */*
@out accepts?(request, "application/json") # out: false
@out accepts?(request, "text/html")        # out: true
@out request.encodings.0.value             # out: *

chunked := send_request("POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nWiki\r\n5;name=x\r\npedia\r\n0\r\nX-Trailer: 1\r\n\r\n")
@out chunked.body # out: Wikipedia

@out send_request("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nab") # out: nil\No_Request
@out send_request("GET / HTTP/1.1\r\nHost: x\r\n") =>= nil\No_Request          # out: true
@out send_request("") =>= nil\No_Request                                       # out: true
@out send_request("\r\n")                                                      # out: nil\Bad_Request
@out send_request("GET / HTTP/1.1\r\n\r\n")                                    # out: nil\Bad_Request

# Expect: 100-continue gets its line before the body is read
client     := Tcp_Socket('localhost', server.port)
connection := server.wait_for_connection()
client.write("POST / HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 2\r\n\r\nhi")
@out read_request(connection).body # out: hi
@out client.read_line().trim()     # out: HTTP/1.1 100 Continue
client.close()
connection.close()
server.close()
