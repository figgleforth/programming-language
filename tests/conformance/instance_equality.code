# A value of a user type with no `@operator ==` compares by its members, the same as a struct or a built-in value
Point {
	x := 0
	y := 0
	Self ( x, y;
		self.x = x
		self.y = y
	)
}
Empty {}
@out Point(1, 2) == Point(1, 2)          # out: true
@out Point(1, 2) == Point(1, 3)          # out: false
@out Point(1, 2) != Point(1, 3)          # out: true
@out Point(1, 2) === Point(3, 4)         # out: true
@out Empty() == Empty()                  # out: true
@out Point(0, 0) == Empty()              # out: false
@out [Point(1, 2)].include?(Point(1, 2)) # out: true

# The object id still tells two equal values apart
a := Point(1, 2)
b := Point(1, 2)
@out a.@object_id == b.@object_id        # out: false

# Two values that point to each other still compare
Node {
	value := 0
	other := nil
	Self ( value;
		self.value = value
	)
}
n1 := Node(1)
n2 := Node(1)
n1.other = n2
n2.other = n1
@out n1 == n2                            # out: true
