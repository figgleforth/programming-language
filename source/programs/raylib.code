# Implemented by Claude
#
# useful: https://www.raylib.com/cheatsheet/cheatsheet.html
#
#
# Thin bindings over the `raylib-bindings` gem (window/drawing/input primitives). Not part of the
# standard library -- opt in with `@load 'programs/raylib'`. Requires `gem install raylib-bindings`;
# the native library itself is only touched the first time one of these is actually called.
#
# A color is a plain Array -- [r, g, b, a] or [r, g, b] (alpha defaults to opaque, 255).
#
#   @load 'programs/raylib'
#
#   Raylib.init_window(800, 450, 'hello raylib')
#   Raylib.set_target_fps(60)
#
#   until Raylib.window_should_close?()
#       Raylib.begin_drawing()
#       Raylib.clear_background([245, 245, 245])
#       Raylib.draw_circle(400, 225, 40, [230, 41, 55])
#       Raylib.draw_text('hello from Backend', 20, 20, 20, [0, 0, 0])
#       Raylib.end_drawing()
#   end
#
#   Raylib.close_window()

Vector2 <x: Number, y: Number>
Pixel | Vector2 <>

# A 2D camera -- `target` is the world-space point mapped to `offset` (the screen-space point it's
# pinned to), `rotation` in degrees pivots around `target`, `zoom` scales around `target` (1 = no
# scale, must never be 0).
Camera_2d <target: Vector2, offset: Vector2, rotation: Number, zoom: Number>

Raylib {
	# --- Window / lifecycle ---
	# `set_config_flags` must be called before `init_window` -- it configures the window `init_window`
	# is about to create, e.g. `Raylib.set_config_flags(Raylib.config_flag(:vsync_hint) | Raylib.config_flag(:msaa_4x_hint))`.
	Self.config_flag ( name: Symbol -> Number; @ruby ) # e.g. :vsync_hint, :msaa_4x_hint, :window_resizable
	Self.set_config_flags ( flags: Number; @ruby )
	Self.init_window ( width: Number, height: Number, title: String; @ruby )
	Self.close_window (; @ruby )
	Self.window_should_close? ( -> Bool; @ruby )
	Self.set_target_fps ( fps: Number; @ruby )
	Self.get_frame_time ( -> Number; @ruby )
	Self.get_time ( -> Number; @ruby ) # seconds since init_window
	Self.get_screen_width ( -> Number; @ruby )
	Self.get_screen_height ( -> Number; @ruby )

	# --- Drawing ---
	Self.begin_drawing (; @ruby )
	Self.end_drawing (; @ruby )
	Self.clear_background ( color: Array; @ruby )

	# --- 2D Camera ---
	# Everything drawn between begin/end is transformed by `camera` -- pan/zoom/rotate the world
	# without recomputing every shape's own coordinates.
	Self.begin_mode_2d ( camera: Camera_2d; @ruby )
	Self.end_mode_2d (; @ruby )

	# --- Shapes ---
	Self.draw_circle ( x: Number, y: Number, radius: Number, color: Array; @ruby )
	Self.draw_circle_lines ( x: Number, y: Number, radius: Number, color: Array; @ruby )
	Self.draw_rectangle ( x: Number, y: Number, width: Number, height: Number, color: Array; @ruby )
	Self.draw_rectangle_lines ( x: Number, y: Number, width: Number, height: Number, color: Array; @ruby )
	# `rect` is [x, y, width, height], `origin` an [x, y] offset (in `rect`'s own space) that
	# `rotation` (degrees) pivots around -- [0, 0] pivots around the rectangle's own top-left corner.
	Self.draw_rectangle_pro ( rect: Array, origin: Array, rotation: Number, color: Array; @ruby )
	Self.draw_line ( x1: Number, y1: Number, x2: Number, y2: Number, color: Array; @ruby )

	# --- Text ---
	Self.draw_text ( text: String, x: Number, y: Number, size: Number, color: Array; @ruby )
	Self.measure_text ( text: String, size: Number -> Number; @ruby )
	Self.draw_fps ( x: Number, y: Number; @ruby )

	# --- Textures / Shaders / Render targets ---
	# A texture/render texture/shader value is opaque to Backend -- hold onto whatever these hand back
	# and pass it straight into the next call, the same way you'd pass around a file handle.
	Self.load_texture ( path: String -> Any; @ruby )
	Self.get_texture_width ( texture: Any -> Number; @ruby )
	Self.get_texture_height ( texture: Any -> Number; @ruby )
	Self.set_texture_filter ( texture: Any, filter: Symbol; @ruby ) # e.g. :bilinear, :point, :trilinear
	Self.gen_color_texture ( width: Number, height: Number, color: Array -> Any; @ruby ) # a placeholder texture, no image file needed -- flat color, so a UV-shift distortion shader has nothing to visibly displace on it
	Self.gen_checked_texture ( width: Number, height: Number, checks_x: Number, checks_y: Number, color1: Array, color2: Array -> Any; @ruby ) # same, but a checkerboard -- has detail a distortion shader can actually show
	Self.load_render_texture ( width: Number, height: Number -> Any; @ruby )
	Self.render_texture_texture ( render_texture: Any -> Any; @ruby )
	Self.load_shader ( vertex_path: String, fragment_path: String -> Any; @ruby ) # either path may be nil
	Self.get_shader_location ( shader: Any, name: String -> Number; @ruby )
	Self.set_shader_value_float ( shader: Any, location: Number, value: Number; @ruby )
	Self.set_shader_value_texture ( shader: Any, location: Number, texture: Any; @ruby ) # binds a texture uniform -- for sampling a *different* texture than whatever's naturally being drawn
	Self.begin_texture_mode ( render_texture: Any; @ruby )
	Self.end_texture_mode (; @ruby )
	Self.begin_shader_mode ( shader: Any; @ruby )
	Self.end_shader_mode (; @ruby )
	Self.draw_texture ( texture: Any, x: Number, y: Number, color: Array; @ruby )
	# `source`/`dest` are [x, y, width, height] Arrays, `origin` an [x, y] Array.
	Self.draw_texture_pro ( texture: Any, source: Array, dest: Array, origin: Array, rotation: Number, color: Array; @ruby )
	Self.unload_texture ( texture: Any; @ruby )
	Self.unload_render_texture ( render_texture: Any; @ruby )
	Self.unload_shader ( shader: Any; @ruby )

	# --- Input: Keyboard ---
	Self.is_key_down? ( key: Symbol -> Bool; @ruby ) # e.g. Raylib.is_key_down?(:right)
	Self.is_key_pressed? ( key: Symbol -> Bool; @ruby )
	Self.key ( name: Symbol -> Number; @ruby ) # e.g. Raylib.key(:right) -> raylib's real KEY_RIGHT integer

	# --- Input: Mouse ---
	# A button is a symbol -- :left, :right, :middle, :side, :extra, :forward, :back.
	Self.get_mouse_position ( -> Pixel; @ruby ) # <x, y> struct
	Self.get_mouse_x ( -> Number; @ruby )
	Self.get_mouse_y ( -> Number; @ruby )
	Self.get_mouse_delta ( -> Pixel; @ruby ) # <x, y> moved since last frame
	Self.get_mouse_wheel_move ( -> Number; @ruby )
	Self.is_mouse_button_down? ( button: Symbol -> Bool; @ruby )
	Self.is_mouse_button_pressed? ( button: Symbol -> Bool; @ruby )
	Self.is_mouse_button_released? ( button: Symbol -> Bool; @ruby )

	# --- Input: Gamepad ---
	# `gamepad` is a 0-based index -- 0 for the first connected controller. A button is a symbol --
	# :left_face_up/down/left/right (d-pad), :right_face_up/down/left/right (the face buttons),
	# :left_trigger_1/2, :right_trigger_1/2, :left_thumb, :right_thumb (stick clicks), :middle_left,
	# :middle, :middle_right (the center buttons). An axis is :left_x, :left_y, :right_x, :right_y,
	# :left_trigger, :right_trigger.
	Self.is_gamepad_available? ( gamepad: Number -> Bool; @ruby )
	Self.get_gamepad_name ( gamepad: Number -> String; @ruby )
	Self.is_gamepad_button_down? ( gamepad: Number, button: Symbol -> Bool; @ruby )
	Self.is_gamepad_button_pressed? ( gamepad: Number, button: Symbol -> Bool; @ruby )
	Self.is_gamepad_button_released? ( gamepad: Number, button: Symbol -> Bool; @ruby )
	Self.get_gamepad_axis_count ( gamepad: Number -> Number; @ruby )
	Self.get_gamepad_axis_movement ( gamepad: Number, axis: Symbol -> Number; @ruby ) # -1.0 .. 1.0
	Self.set_gamepad_vibration ( gamepad: Number, left_motor: Number, right_motor: Number, duration: Number; @ruby ) # motor strength 0.0 .. 1.0, duration in seconds

	# --- Audio ---
	# A sound/music value is opaque to Backend, same as a texture or shader -- hold onto whatever
	# these hand back and pass it straight into the next call.
	Self.init_audio_device (; @ruby )
	Self.close_audio_device (; @ruby )
	Self.is_audio_device_ready? ( -> Bool; @ruby )

	Self.load_sound ( path: String -> Any; @ruby )
	Self.play_sound ( sound: Any; @ruby )
	Self.stop_sound ( sound: Any; @ruby )
	Self.is_sound_playing? ( sound: Any -> Bool; @ruby )
	Self.set_sound_volume ( sound: Any, volume: Number; @ruby ) # 1.0 is max
	Self.set_sound_pitch ( sound: Any, pitch: Number; @ruby ) # 1.0 is base
	Self.unload_sound ( sound: Any; @ruby )

	Self.load_music_stream ( path: String -> Any; @ruby )
	Self.play_music_stream ( music: Any; @ruby )
	Self.update_music_stream ( music: Any; @ruby ) # call once per frame while playing, or it stops streaming
	Self.stop_music_stream ( music: Any; @ruby )
	Self.pause_music_stream ( music: Any; @ruby )
	Self.resume_music_stream ( music: Any; @ruby )
	Self.set_music_volume ( music: Any, volume: Number; @ruby ) # 1.0 is max
	Self.is_music_stream_playing? ( music: Any -> Bool; @ruby )
	Self.unload_music_stream ( music: Any; @ruby )

	# --- Low-level (rlgl) ---
	# Immediate-mode vertex drawing, for shapes the higher-level draw_* calls can't express -- e.g. a
	# textured quad whose four corners don't form an axis-aligned rectangle. Every rl_vertex call
	# uses whatever rl_color/rl_tex_coord/rl_normal was set most recently, the same "current state"
	# style as OpenGL's own immediate mode. Always rl_begin_quads, four rl_vertex calls, rl_end.
	Self.rl_set_texture ( texture: Any; @ruby ) # binds the texture rl_tex_coord's 0..1 UVs sample from
	Self.rl_begin_quads (; @ruby )
	Self.rl_end (; @ruby )
	Self.rl_color ( color: Array; @ruby )
	Self.rl_normal ( x: Number, y: Number, z: Number; @ruby )
	Self.rl_tex_coord ( u: Number, v: Number; @ruby )
	Self.rl_vertex ( x: Number, y: Number; @ruby )

	# --- Useful ---
	Self.get_fps (-> Number; @ruby)
	Self.get_random_value ( min: Number, max: Number -> Number; @ruby ) # both ends included
}
